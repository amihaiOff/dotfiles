# Homebrew Bundle — single source of truth for packages on a new Mac.
# Install with:  brew bundle --file ~/dotfiles/brewfile
# (setup_script.sh runs this for you.)

cask_args appdir: '~/Applications'

# ── Taps ─────────────────────────────────────────────────────────────
tap 'homebrew/services'
# NOTE: lazygit, yazi, starship, etc. are all in homebrew/core now — no custom taps needed.

# ── CLI essentials ───────────────────────────────────────────────────
brew 'git'          # Version control
brew 'stow'         # Symlink farm manager (creates the dotfile symlinks)
brew 'tmux'         # Terminal multiplexer
brew 'byobu'        # tmux wrapper / session manager
brew 'vim'          # Editor
brew 'neovim'       # Editor (nvim)

# ── CLI tools referenced by the shell / aliases / configs ────────────
brew 'bat'          # Better cat (used by `bc` alias)
brew 'broot'        # Interactive directory navigation
brew 'duf'          # Better df
brew 'eza'          # Better ls (used by `l`, `lt`, `lsg` aliases; replaces dead exa)
brew 'fzf'          # Fuzzy finder (fzf-tab / fzf-zsh plugins)
brew 'jdupes'       # Duplicate file finder
brew 'procs'        # Better ps
brew 'ripgrep'      # Better grep
brew 'tldr'         # Community man pages
brew 'tree'         # Directory tree listings
brew 'trash-cli'    # Safe rm
brew 'watch'        # Re-run a command periodically (used by file_watch)
brew 'dust'         # Better du (du-dust)
brew 'glow'         # Markdown renderer (used by `gen_shortcuts` alias)
brew 'carapace'     # Multi-shell completion engine
brew 'yazi'         # Terminal file manager (used by `yy` function)
brew 'bpytop'       # Resource monitor (used by `b` alias)
brew 'lazygit'      # Git TUI (used by `lz` alias)
brew 'starship'     # Prompt (eval'd in .zshrc)
brew 'atuin'        # Shell history (eval'd in .zshrc)
brew 'herdr'        # Agent multiplexer that lives in your terminal

# ── Version managers ─────────────────────────────────────────────────
brew 'pyenv'        # Python version manager (eval'd in .zshrc)
brew 'uv'           # Fast Python package/venv manager
# nvm, poetry and rust/cargo are installed via their own installers in setup_script.sh
# (nvm and poetry aren't reliably kept up to date as brew formulae).

# ── Fonts (Nerd Fonts for eza icons + kitty/ghostty/starship glyphs) ──
cask 'font-meslo-lg-nerd-font'
cask 'font-caskaydia-cove-nerd-font'

# ── GUI apps ─────────────────────────────────────────────────────────
cask 'arc'                   # Browser
cask 'google-chrome'         # Browser
cask 'ghostty'               # Terminal emulator
cask 'cursor'                # Editor (its settings/keybindings are symlinked by setup_script.sh)
cask 'sublime-text'          # Editor (on PATH via .zshrc)
cask 'karabiner-elements'    # Keyboard remapper (config stowed to ~/.config/karabiner)
cask 'raycast'               # Launcher (import the .rayconfig manually — see setup_script reminders)
cask 'flux'                  # Blue-light filter
cask 'shottr'                # Screenshot tool (measurement + annotation)
cask 'adobe-acrobat-reader'  # PDF reader (free Reader; Acrobat Pro must be installed manually)
cask 'claude'                # Anthropic Claude desktop app
cask 'claude-code'           # Claude Code CLI
cask 'slack'                 # Chat
cask 'zoom'                  # Video calls
cask 'spotify'               # Music
cask '1password'             # Password manager
cask 'docker-desktop'        # Containers (Docker Desktop; 'docker' is an alias for this)
